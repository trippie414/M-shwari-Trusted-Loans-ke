# Flask
SECRET_KEY=change-me-to-a-long-random-string
# postgres example: postgresql://loan:password@localhost:5432/loan_portal
DATABASE_URL=sqlite:///loan_portal.db
SESSION_COOKIE_SECURE=false

# Laboratory mode — default safe sandbox. NEVER set false without real credentials.
LAB_MODE=true

# Payment provider: sandbox | mpesa
PAYMENT_PROVIDER=sandbox
# What the STK push charges: service_fee | loan_amount | total
PAYMENT_AMOUNT_MODE=total

# M-Pesa / Daraja (only used when PAYMENT_PROVIDER=mpesa)
PAYMENT_CONSUMER_KEY=
PAYMENT_CONSUMER_SECRET=
PAYMENT_PASSKEY=
PAYMENT_SHORTCODE=
M_PESA_ENV=sandbox

# Sandbox simulation tuning
SANDBOX_SUCCESS_DELAY_SECONDS=6
SANDBOX_FAILURE_RATE=0.0

# Rate limiting
RATELIMIT_DEFAULT=60 per minute

# Configurable copy
DISCLAIMER_TEXT=LOAN PORTAL KE is an independent application portal. It is not operated by Safaricom, M-Shwari, or any government agency.
STK_HELPER_TEXT=Once you receive an STK push, finish your payment and receive your loan.